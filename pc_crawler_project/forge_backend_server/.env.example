# 複製這個檔案為 .env，並填入實際的值。
# .env 不會被 git 追蹤，請勿把真實密碼寫進這個 .env.example 檔案裡。

SECRET_KEY=請填入新產生的secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=forge_db
DB_USER=forgeowner
DB_PASSWORD=請填入資料庫密碼
DB_HOST=192.168.0.241
DB_PORT=3306

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://192.168.0.243:8080
