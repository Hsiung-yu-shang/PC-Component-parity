# 複製這個檔案為 .env，並填入實際的值。
# .env 不會被 git 追蹤，請勿把真實密碼寫進這個 .env.example 檔案裡。

SECRET_KEY=replace-with-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,pcpart.hsiungyusheng.me,pcpartapi.hsiungyusheng.me

DB_NAME=forge_db
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=3306

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://pcpart.hsiungyusheng.me
SYNC_API_TOKEN=

# LXC installer uses /var/lib/pcpart for persistent locks/cooldowns.
# HTTPS admin cookies; leave redirects off while testing through the LXC HTTP IP.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=https://pcpart.hsiungyusheng.me
